<CORE-CONTENT><REQ-IF-CONTENT>
<DATATYPES><DATATYPE-DEFINITION-STRING IDENTIFIER="dt-s" LONG-NAME="String" MAX-LENGTH="4000" LAST-CHANGE="2026-08-01T00:00:00Z"/><DATATYPE-DEFINITION-XHTML IDENTIFIER="dt-x" LONG-NAME="XHTML" LAST-CHANGE="2026-08-01T00:00:00Z"/></DATATYPES>
