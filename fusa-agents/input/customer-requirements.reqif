<ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="ad-text" LONG-NAME="Text" LAST-CHANGE="2026-08-01T00:00:00Z"><TYPE><DATATYPE-DEFINITION-XHTML-REF>dt-x</DATATYPE-DEFINITION-XHTML-REF></TYPE></ATTRIBUTE-DEFINITION-XHTML>
