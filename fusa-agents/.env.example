# Copy to `.env` (gitignored) and fill in the provider you use.
# A real environment variable always wins over anything set here.
# See docs/SOP-local-llm.md for the full procedure per provider.

# --- pick one backend -------------------------------------------------------
# anthropic (default) | grok | groq | openai | gemini
FUSA_PROVIDER=grok

# --- the key for that backend ----------------------------------------------
# XAI_API_KEY=xai-...                 # grok    — console.x.ai
# GROQ_API_KEY=gsk_...                # groq    — console.groq.com
# ANTHROPIC_API_KEY=sk-ant-...        # anthropic
# OPENAI_API_KEY=sk-...               # openai  — platform.openai.com
# GEMINI_API_KEY=AIza...              # gemini  — aistudio.google.com

# --- optional ---------------------------------------------------------------
# FUSA_MODEL=grok-4.6                 # default per provider; see the SOP
# FUSA_MAX_TOKENS=6000
# FUSA_DRY_RUN=1                      # no model calls at all, no key needed
# ANTHROPIC_BASE_URL=http://localhost:11434   # local LLM via Ollama
